---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Layout from '../layouts/main.astro';
import { AboutSection } from '@/components/AboutSection';
import { Shield, Target, Award, Users } from 'lucide-react';
import { getImage } from 'astro:assets';

const reader = createReader(process.cwd(), keystaticConfig);
const homepageData = await reader.singletons.homepage.read();

// Load about background image
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hero-images/*');
const resolveImage = async (imagePath: string | undefined) => {
  if (!imagePath) return null;
  const key = imagePath.replace('@/', '/src/');
  const loader = images[key];
  if (!loader) {
      console.warn(`Image not found for path: ${imagePath} (key: ${key})`);
      return null;
  }
  const mod = await loader();
  const optimized = await getImage({ src: mod.default, format: 'webp', width: 1920 });
  return optimized.src;
};
const aboutBgImage = await resolveImage(homepageData?.aboutBackgroundImage);
---

<Layout title="About Us - Wijaya Partners" fullScreen={true} noPadding={true}>
	<AboutSection 
		id="about"
		client:load 
		heading={homepageData?.aboutHeading}
		headingHighlight={homepageData?.aboutHeadingHighlight}
		subheading={homepageData?.aboutSubheading}
        backgroundImage={aboutBgImage}
	/>

