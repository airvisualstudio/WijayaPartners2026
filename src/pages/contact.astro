---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Layout from '../layouts/main.astro';
import { Button } from '@/components/ui/button';
import { Mail, MapPin, Phone, Send, Clock, Twitter, Github, Linkedin } from 'lucide-react';

const reader = createReader(process.cwd(), keystaticConfig);
const contactData = await reader.singletons.contact.read();
---

<Layout title={`${contactData?.heading || 'Contact'} - Wijaya Partners`}>
	<section class="pt-20 md:pt-32 pb-0">
		<div class="container mx-auto px-4">
			<div class="max-w-5xl mx-auto">
				<div class="text-center space-y-4 mb-16 px-4">
					<h1 class="text-4xl md:text-7xl font-extrabold tracking-tighter">
						{contactData?.heading.split(' ').slice(0, -1).join(' ')}
						<span class="bg-gradient-to-r from-primary via-purple-500 to-primary bg-clip-text text-transparent animate-gradient">
							 {contactData?.heading.split(' ').pop()}
						</span>
					</h1>
					<p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
						{contactData?.subheading}
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-24">
					<!-- Contact Form -->
					<div class="lg:col-span-8 order-2 lg:order-1">
						<div class="p-8 md:p-12 rounded-3xl border bg-card/50 backdrop-blur-sm shadow-xl">
							<h2 class="text-2xl font-bold mb-8">Send us a message</h2>
							<form class="space-y-6">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div class="space-y-2">
										<label for="name" class="text-sm font-bold tracking-widest uppercase text-muted-foreground ml-1">
											Name
										</label>
										<input
											type="text"
											id="name"
											name="name"
											class="flex h-12 w-full rounded-xl border bg-background/50 px-4 py-2 text-sm transition-all focus:ring-2 focus:ring-primary/20 outline-none"
											placeholder="Your full name"
											required
										/>
									</div>
									<div class="space-y-2">
										<label for="email" class="text-sm font-bold tracking-widest uppercase text-muted-foreground ml-1">
											Email
										</label>
										<input
											type="email"
											id="email"
											name="email"
											class="flex h-12 w-full rounded-xl border bg-background/50 px-4 py-2 text-sm transition-all focus:ring-2 focus:ring-primary/20 outline-none"
											placeholder="email@example.com"
											required
										/>
									</div>
								</div>

								<div class="space-y-2">
									<label for="subject" class="text-sm font-bold tracking-widest uppercase text-muted-foreground ml-1">
										Subject
									</label>
									<input
										type="text"
										id="subject"
										name="subject"
										class="flex h-12 w-full rounded-xl border bg-background/50 px-4 py-2 text-sm transition-all focus:ring-2 focus:ring-primary/20 outline-none"
										placeholder="What is this regarding?"
										required
									/>
								</div>

								<div class="space-y-2">
									<label for="message" class="text-sm font-bold tracking-widest uppercase text-muted-foreground ml-1">
										Message
									</label>
									<textarea
										id="message"
										name="message"
										rows="6"
										class="flex w-full rounded-xl border bg-background/50 px-4 py-3 text-sm transition-all focus:ring-2 focus:ring-primary/20 outline-none resize-none"
										placeholder="Tell us how we can assist you..."
										required
									></textarea>
								</div>

								<button
									type="submit"
									class="inline-flex items-center justify-center gap-2 h-14 px-10 rounded-full bg-primary text-primary-foreground font-bold hover:bg-primary/90 transition-all hover:scale-[1.02] active:scale-95 shadow-lg shadow-primary/20 w-full md:w-auto"
								>
									<Send class="h-5 w-5" />
									Submit Inquiry
								</button>
							</form>
						</div>
					</div>

					<!-- Contact Info -->
					<div class="lg:col-span-4 space-y-8 order-1 lg:order-2">
						<div class="space-y-8">
							<div class="flex gap-4 group">
								<div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-2xl bg-primary/10 text-primary border border-primary/20 group-hover:bg-primary group-hover:text-white transition-all duration-300">
									<Mail class="h-5 w-5" />
								</div>
								<div>
									<h3 class="text-sm font-bold tracking-widest uppercase mb-2">Email</h3>
									<p class="text-muted-foreground text-sm font-medium">{contactData?.email1}</p>
									<p class="text-muted-foreground text-sm font-medium">{contactData?.email2}</p>
								</div>
							</div>

							<div class="flex gap-4 group">
								<div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-2xl bg-primary/10 text-primary border border-primary/20 group-hover:bg-primary group-hover:text-white transition-all duration-300">
									<Phone class="h-5 w-5" />
								</div>
								<div>
									<h3 class="text-sm font-bold tracking-widest uppercase mb-2">Phone & Hours</h3>
									<p class="text-muted-foreground text-sm font-medium">{contactData?.phone}</p>
									<div class="flex items-center gap-2 mt-1 text-xs text-muted-foreground/60">
										<Clock class="h-3 w-3" />
										<span>{contactData?.hours}</span>
									</div>
								</div>
							</div>

							<div class="flex gap-4 group">
								<div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-2xl bg-primary/10 text-primary border border-primary/20 group-hover:bg-primary group-hover:text-white transition-all duration-300">
									<MapPin class="h-5 w-5" />
								</div>
								<div>
									<h3 class="text-sm font-bold tracking-widest uppercase mb-2">Law Office</h3>
									<p class="text-muted-foreground text-sm font-medium leading-relaxed whitespace-pre-line">
										{contactData?.address}
									</p>
								</div>
							</div>
						</div>

						<!-- Socials -->
						<div class="pt-8 border-t border-border">
							<h3 class="text-sm font-bold tracking-widest uppercase mb-4">Connect With Us</h3>
							<div class="flex gap-3">
								{contactData?.twitter && (
									<a href={contactData.twitter} target="_blank" rel="noopener noreferrer" class="h-10 w-10 flex items-center justify-center rounded-xl border border-border bg-card hover:bg-primary hover:text-white hover:border-primary transition-all duration-300">
										<Twitter class="h-4 w-4" />
									</a>
								)}
								{contactData?.github && (
									<a href={contactData.github} target="_blank" rel="noopener noreferrer" class="h-10 w-10 flex items-center justify-center rounded-xl border border-border bg-card hover:bg-primary hover:text-white hover:border-primary transition-all duration-300">
										<Github class="h-4 w-4" />
									</a>
								)}
								{contactData?.linkedin && (
									<a href={contactData.linkedin} target="_blank" rel="noopener noreferrer" class="h-10 w-10 flex items-center justify-center rounded-xl border border-border bg-card hover:bg-primary hover:text-white hover:border-primary transition-all duration-300">
										<Linkedin class="h-4 w-4" />
									</a>
								)}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Full Size Map -->
		<div class="w-full h-[500px] bg-muted relative mt-12 grayscale hover:grayscale-0 transition-all duration-1000">
			{contactData?.mapsEmbedUrl ? (
				<iframe 
					src={contactData.mapsEmbedUrl} 
					width="100%" 
					height="100%" 
					style="border:0;" 
					allowfullscreen="" 
					loading="lazy" 
					referrerpolicy="no-referrer-when-downgrade"
					class="w-full h-full"
				></iframe>
			) : (
				<div class="absolute inset-0 flex items-center justify-center text-muted-foreground/30">
					Map URL not configured
				</div>
			)}
		</div>
	</section>
</Layout>
